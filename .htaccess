Redirect 301 /rubbish-removal-croydon.html /areas/croydon/
Redirect 301 /rubbish-removal-croydon-north.html /areas/croydon-north/
Redirect 301 /rubbish-removal-croydon-hills.html /areas/croydon-hills/
Redirect 301 /rubbish-removal-wonga-park.html /areas/wonga-park/
