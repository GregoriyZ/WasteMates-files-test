# WasteMates — Apache config for GoDaddy shared hosting

# Disable directory listings
Options -Indexes

# Custom 404 page
ErrorDocument 404 /404.html

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# --- Enquiry form backend: block direct access to secrets/library files ---
# (Belt-and-braces — config.php just returns a PHP array so PHP execution
# alone already prevents leaking it, but this covers a misconfigured host.)
<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>
<IfModule mod_alias.c>
  RedirectMatch 403 ^/lib/
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Redirect www to non-www (canonical host: wastemates.com.au) ---
# The origin-side force-HTTPS rewrite that used to live here is REMOVED —
# it was never actually the cause of the 2026-08-05 outage (confirmed: the
# loop persists byte-for-byte identically even with Cloudflare's proxy
# bypassed entirely via DNS, hitting the GoDaddy origin directly). The
# real cause of the "/" and "/services/" loops is still unidentified —
# nothing in this file, cPanel, or Cloudflare's dashboard (Page Rules,
# Redirect Rules, Bulk Redirects, Workers) explains it. Left removed since
# re-adding it never helped and risks reintroducing a loop on its own.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.wastemates\.com\.au [NC]
  RewriteRule ^(.*)$ https://wastemates.com.au/$1 [R=301,L]
</IfModule>

# --- Clean URL migration (flat .html pages -> directory-based clean URLs) ---
# Preserves link equity from the previous flat-HTML site structure
Redirect 301 /index.html /
Redirect 301 /about.html /about/
Redirect 301 /contact.html /contact/
Redirect 301 /faq.html /faq/
Redirect 301 /pricing.html /pricing/
# NOTE: no "/services.html -> /services/" rule here on purpose. Something
# outside this repo's control already redirects /services/ -> services.html
# (root cause unknown — see WORKAROUND note on the services.html file
# itself). Redirecting services.html back to /services/ here would recreate
# that exact infinite loop. services.html is instead a real, standalone
# page (not a redirect) so that bounce terminates instead of looping.

# --- Legacy WordPress URL redirects (old site, pre-rebuild) ---
# Preserves any backlink/SEO equity pointing at the old site's URLs
Redirect 301 /about-us/ /about/
Redirect 301 /contact-us/ /contact/
Redirect 301 /faqs/ /faq/
Redirect 301 /get-quote/ /contact/
Redirect 301 /home/ /

# Flat .html -> directory URLs for the 6 new dedicated service pages added
# alongside the original 6 (order matters: these specific rules must come
# before any generic /services/ rule, per the mod_alias prefix-matching bug
# fixed 2026-08-04 — see the /services/ rules directly below)
Redirect 301 /green-waste-removal.html /services/green-waste-removal/
Redirect 301 /construction-waste-removal.html /services/construction-waste-removal/
Redirect 301 /renovation-waste-removal.html /services/renovation-waste-removal/
Redirect 301 /body-corporate-real-estate.html /services/body-corporate-real-estate/
Redirect 301 /garage-shed-cleanouts.html /services/garage-shed-cleanouts/
Redirect 301 /commercial-office-cleanouts.html /services/commercial-office-cleanouts/

# Legacy WordPress URLs, mapped to their closest dedicated page (specific
# rules before the generic /services/ rule further down — same ordering
# rule as above)
Redirect 301 /services/household-rubbish-removal/ /services/rubbish-removal/
Redirect 301 /services/green-waste/ /services/green-waste-removal/
Redirect 301 /services/food-waste/ /services/green-waste-removal/
Redirect 301 /services/construction-waste-removalists/ /services/construction-waste-removal/
Redirect 301 /services/body-corporate-real-estate/ /services/body-corporate-real-estate/
Redirect 301 /services/renovations/ /services/renovation-waste-removal/
Redirect 301 /household-rubbish-removal/ /services/rubbish-removal/
Redirect 301 /green-waste-removal/ /services/green-waste-removal/
Redirect 301 /food-waste-removal/ /services/green-waste-removal/
Redirect 301 /construction-waste-removal/ /services/construction-waste-removal/
Redirect 301 /body-corporate-real-estate/ /services/body-corporate-real-estate/
Redirect 301 /renovations/ /services/renovation-waste-removal/
Redirect 301 /renovations-and-rubbish-removal/ /services/renovation-waste-removal/
Redirect 301 /garage-cleanups/ /services/garage-shed-cleanouts/

# Flat suburb-page .html -> directory URLs under /areas/
Redirect 301 /service-areas.html /areas/
Redirect 301 /rubbish-removal-mooroolbark.html /areas/mooroolbark/
Redirect 301 /rubbish-removal-chirnside-park.html /areas/chirnside-park/
