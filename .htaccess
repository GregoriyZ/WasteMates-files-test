# WasteMates — Apache config for GoDaddy shared hosting

# Disable directory listings
Options -Indexes

# Custom 404 page
ErrorDocument 404 /404.html

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# --- Enquiry form backend: block direct access to secrets/library files ---
# (Belt-and-braces — config.php just returns a PHP array so PHP execution
# alone already prevents leaking it, but this covers a misconfigured host.)
<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>
<IfModule mod_alias.c>
  RedirectMatch 403 ^/lib/
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Force HTTPS and redirect www to non-www (canonical host: wastemates.com.au) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://wastemates.com.au/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.wastemates\.com\.au [NC]
  RewriteRule ^(.*)$ https://wastemates.com.au/$1 [R=301,L]
</IfModule>

# --- Legacy WordPress URL redirects (old site, pre-rebuild) ---
# Preserves any backlink/SEO equity pointing at the old site's URLs
Redirect 301 /about-us/ /about.html
Redirect 301 /contact-us/ /contact.html
Redirect 301 /contact/ /contact.html
Redirect 301 /faqs/ /faq.html
Redirect 301 /get-quote/ /contact.html
Redirect 301 /home/ /

Redirect 301 /services/ /services.html
Redirect 301 /services/household-rubbish-removal/ /services.html
Redirect 301 /services/green-waste/ /green-waste-removal.html
Redirect 301 /services/food-waste/ /green-waste-removal.html
Redirect 301 /services/construction-waste-removalists/ /construction-waste-removal.html
Redirect 301 /services/body-corporate-real-estate/ /body-corporate-real-estate.html
Redirect 301 /services/renovations/ /renovation-waste-removal.html
Redirect 301 /household-rubbish-removal/ /services.html
Redirect 301 /green-waste-removal/ /green-waste-removal.html
Redirect 301 /food-waste-removal/ /green-waste-removal.html
Redirect 301 /construction-waste-removal/ /construction-waste-removal.html
Redirect 301 /body-corporate-real-estate/ /body-corporate-real-estate.html
Redirect 301 /renovations/ /renovation-waste-removal.html
Redirect 301 /renovations-and-rubbish-removal/ /renovation-waste-removal.html
Redirect 301 /garage-cleanups/ /garage-shed-cleanouts.html

# Old blog — no equivalent section on the new site, send to home
Redirect 301 /blog/ /
